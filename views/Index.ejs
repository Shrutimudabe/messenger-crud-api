<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>mini whatsapp</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h2>All Chats!</h2>
    <form method="GET" action="/chats/new">
        <button>New chat</button>
    </form>
    <br><br>
    <%for(let chat of chats){%>
        <div class="chat">
            <p>From:<i>
                    <%=chat.from%>
                </i>
            </p>
            <div class="msg">
                <p>
                    <%=chat.msg%>
                </p>
                <br>
                <div class="buttons">
                    <div class="editBtn">
                        <form class="formBtn" method="GET" action="/chats/<%=chat._id%>/edit">

                            <button id="edit">edit</button>

                        </form>
                    </div>


                    <br>

                    <div class="deleteBtn">
                        <form class="formBtn" method="POST" action="/chats/<%=chat._id%>?_method=DELETE">

                            <button id="delete">delete</button>

                        </form>
                    </div>
                </div>



            </div>
            <br><br>

            <p>recieved by:<i>
                    <%=chat.to%>
                </i>
            </p>
            <hr>
            <p>
                <%=chat.created_at.toString().split(" ")[4]%>
            </p>
            <p><%=chat.created_at.toString().split(" ").slice(0,4).join(" -")%>
            </p>

        </div>
        <br><br>

        <%}%>
</body>

</html>